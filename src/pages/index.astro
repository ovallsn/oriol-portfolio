---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import { portfolio } from '../data/portfolio';
import SiteLayout from '../layouts/SiteLayout.astro';

const locale = 'en';
const copy = portfolio.copy[locale];
---

<SiteLayout
  locale="en"
  title="Oriol Valls — Technical & Application Support"
  description="Technical and application support professional focused on clear troubleshooting, internal systems, and client operations."
  canonicalPath="/"
>
  <Hero locale={locale} copy={copy.hero} cvLinks={portfolio.cvLinks} />
  <About locale={locale} about={copy.about} approach={copy.approach} />
  <Projects locale={locale} copy={copy.work} projects={portfolio.projects} />
  <Skills locale={locale} copy={copy.skills} groups={portfolio.skillGroups} />
  <Experience locale={locale} copy={copy.experience} entries={portfolio.experience} />
  <Contact locale={locale} copy={copy.contact} links={portfolio.contact} />
</SiteLayout>
