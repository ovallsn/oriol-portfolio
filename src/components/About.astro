---
import { Image } from 'astro:assets';
import portrait from '../assets/profile/oriol-valls-dark.webp';
import type { Locale, PortfolioCopy } from '../data/portfolio';

interface Props {
  locale: Locale;
  about: PortfolioCopy['about'];
  approach: PortfolioCopy['approach'];
}

const { locale, about, approach } = Astro.props;
const isEnglish = locale === 'en';
const mark = `${import.meta.env.BASE_URL}oriol-mark.png`;
---

<section class="content-section profile-section" id="about" aria-labelledby="about-title">
  <div class="profile-grid">
    <div class="profile-copy">
      <h2 id="about-title">{about.title}</h2>
      <p>{about.body}</p>
      <p>{about.secondBody}</p>
      <a class="work-link" href="#contact">
        {isEnglish ? 'Get in touch' : 'Contactar conmigo'}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" /></svg>
      </a>
    </div>
    <div class="profile-portrait-stage" data-portrait-scene>
      <div class="profile-portrait-card">
        <figure class="profile-portrait">
          <Image class="profile-portrait-photo" src={portrait} alt={isEnglish ? 'Portrait of Oriol Valls' : 'Retrato de Oriol Valls'} widths={[320, 480, 720]} sizes="(max-width: 390px) calc(100vw - 2rem), 360px" />
          <figcaption class="profile-portrait-caption">
            <strong>Oriol Valls</strong>
            <span>{isEnglish ? 'Technical & application support' : 'Soporte técnico y de aplicaciones'}</span>
            <span class="profile-portrait-availability">{isEnglish ? 'Open to remote work' : 'Disponible para trabajo remoto'}</span>
          </figcaption>
        </figure>
        <div class="profile-portrait-back" aria-hidden="true">
          <img src={mark} width="76" height="76" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <details class="work-case profile-approach" id="approach">
    <summary>{approach.title}</summary>
    <ol class="profile-steps">
      {approach.steps.map((step) => (
        <li>
          <strong>{step.title}</strong>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </details>
</section>

<script>
  import '../scripts/portrait-scroll';
</script>
