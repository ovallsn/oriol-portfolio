---
import type { ExperienceEntry, Locale, PortfolioCopy } from '../data/portfolio';

interface Props {
  locale: Locale;
  copy: PortfolioCopy['experience'];
  entries: ExperienceEntry[];
}

const { locale, copy, entries } = Astro.props;
const isEnglish = locale === 'en';
const operations = new Set(['valls-solutions', 'cero-agency']);
const tracks = [
  {
    id: 'technical',
    title: isEnglish ? 'IT support & development' : 'Soporte y desarrollo',
    entries: entries.filter((entry) => !operations.has(entry.id)),
  },
  {
    id: 'operations',
    title: isEnglish ? 'Operations & business' : 'Operaciones y negocio',
    entries: entries.filter((entry) => operations.has(entry.id)),
  },
];
---

<section class="content-section experience-section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading experience-heading">
    <h2 id="experience-title">{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>

  <div class="career-tracks">
    {tracks.map((track) => (
      <section class="career-track" aria-labelledby={`career-${track.id}`}>
        <h3 id={`career-${track.id}`}>{track.title}</h3>
        <ol class="career-timeline">
          {track.entries.map((entry) => (
            <li class="career-item" id={entry.id} data-scroll-reveal>
              <p class="career-date">{entry.dates[locale]}</p>
              <h4>{entry.title[locale]}</h4>
              <p class="career-company">{entry.company}</p>
              <p class="career-description">{entry.description[locale]}</p>
              {entry.note && <p class="career-note">{entry.note[locale]}</p>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</section>
