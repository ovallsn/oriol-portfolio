---
import type { ContactLinks, Locale, PortfolioCopy } from '../data/portfolio';

interface Props {
  locale: Locale;
  copy: PortfolioCopy['contact'];
  links: ContactLinks;
}

const { locale, copy, links } = Astro.props;
const isEnglish = locale === 'en';
const contactLinks = [
  { label: copy.linkedinLabel, href: links.linkedin, text: 'linkedin.com/in/oriolvallsn' },
  { label: copy.githubLabel, href: links.github, text: 'github.com/ovallsn' },
];
---

<section class="content-section reach-section" id="contact" aria-labelledby="contact-title">
  <div class="reach-panel" data-scroll-reveal>
    <div class="reach-copy">
      <h2 id="contact-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>

    <div class="reach-actions">
      <a class="reach-email" href={`mailto:${links.email}`}>
        <span>
          <strong>{isEnglish ? 'Email me' : 'Escríbeme por correo'}</strong>
          <span>{links.email}</span>
        </span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" /></svg>
      </a>
      <ul class="reach-links">
        {contactLinks.map((link) => (
          <li>
            <a href={link.href}>
              <span><strong>{link.label}</strong><span>{link.text}</span></span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
